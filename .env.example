# =============================================================================
# docker compose — copy to `.env` (gitignored) to tune the BACKEND without
# editing docker-compose.yml. All optional; compose already defaults each.
# =============================================================================
APP_TIMEZONE=Asia/Kolkata
ADMIN_TOKEN=
# Browser origins allowed to call the API (CORS), comma-separated. Blank = the local UI only:
# http://localhost:3100, http://127.0.0.1:3100, http://localhost:3000, http://127.0.0.1:3000.
CORS_ORIGINS=
FLIPKART_MAX_PAGES=100
FLIPKART_MAX_DETAILS=40
# Lifecycle (cancelled / replacement / refund) detail lookups: only orders placed in the last
# FLIPKART_HISTORY_DAYS days, at most FLIPKART_MAX_HISTORY_DETAILS detail calls per account.
FLIPKART_HISTORY_DAYS=30
FLIPKART_MAX_HISTORY_DETAILS=150
FLIPKART_TIMEOUT_MS=20000

# Background poller (scales to 1000+ accounts): refresh each account every REFRESH_INTERVAL_S
# seconds (default 30 min = 1800), fetching at most FETCH_CONCURRENCY accounts concurrently.
REFRESH_INTERVAL_S=1800
FETCH_CONCURRENCY=16

# MinIO (S3) cookie storage — credentials for the bundled minio service + bucket name.
# The app is local-only: the S3 port (9000) isn't published, the console binds to 127.0.0.1.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=flipkart-cookies

# =============================================================================
# local `npm run dev` (frontend only; docker compose bakes these itself)
#   NEXT_PUBLIC_BACKEND_URL — URL the browser calls directly; empty = same-origin (Next proxy)
#   BACKEND_URL             — server-side rewrite-proxy target for dev
# =============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
