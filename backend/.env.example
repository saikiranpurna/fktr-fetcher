# Flipkart Delivery Tracker — Python backend configuration.
# Copy to `backend/.env` (auto-loaded on local `uvicorn` runs; gitignored).
# In Docker these come from docker-compose instead. All optional — defaults are baked in.

# Timezone used by the frontend for the "today / next 7 days" filters.
APP_TIMEZONE=Asia/Kolkata

# Where dropped account cookies are persisted (Docker overrides this to /data/... on a volume).
SESSION_STORE_PATH=.flipkart-session.json

# Cookie storage backend: minio | file | auto (default). "auto" uses MinIO when MINIO_ENDPOINT
# is set, else the JSON file above. For a plain local `uvicorn` run, leave STORAGE_BACKEND=auto
# and the MINIO_* lines commented to persist to the file. (docker-compose keeps MinIO's S3 port
# 9000 internal, so the endpoint below only works if you publish it yourself as 127.0.0.1:9000:9000.)
STORAGE_BACKEND=auto
#MINIO_ENDPOINT=http://localhost:9000
#MINIO_ACCESS_KEY=minioadmin
#MINIO_SECRET_KEY=minioadmin
#MINIO_BUCKET=flipkart-cookies
#MINIO_REGION=us-east-1

# Set to require the header "x-admin-token" on account add/remove. Blank = open (local use).
ADMIN_TOKEN=

# Browser origins allowed to call the API (CORS), comma-separated. The API serves customer PII and
# live OTPs, so only the local UI should be listed. Blank = http://localhost:3100,
# http://127.0.0.1:3100 (Docker UI) and http://localhost:3000, http://127.0.0.1:3000 (npm run dev).
CORS_ORIGINS=

# Paginate My Orders (7/page). Stops early when there are no more orders; safety cap (~700 orders).
FLIPKART_MAX_PAGES=100

# Address-only detail lookups (one per order) for this many recent orders with no active shipment.
# 0 turns off only these: out-for-delivery/arriving shipments always get their OTP lookup, and
# cancelled/refunded/replaced orders use FLIPKART_HISTORY_DAYS / FLIPKART_MAX_HISTORY_DETAILS.
FLIPKART_MAX_DETAILS=40

# Lifecycle details (cancelled / replacement / refund dates) are looked up only for orders placed
# within the last FLIPKART_HISTORY_DAYS days, at most FLIPKART_MAX_HISTORY_DETAILS calls per account
# (after every out-for-delivery unit, before the address-only lookups). FLIPKART_MAX_HISTORY_DETAILS=0
# turns them off.
FLIPKART_HISTORY_DAYS=30
FLIPKART_MAX_HISTORY_DETAILS=150

# Per-request timeout in milliseconds.
FLIPKART_TIMEOUT_MS=20000

# curl_cffi TLS-impersonation profile used by Scrapling (chrome | chrome124 | edge | safari ...).
FLIPKART_IMPERSONATE=chrome

# ── Background poller ─────────────────────────────────────────────────────────
# Keeps an in-memory order cache warm so /api/orders is instant at 1000+ accounts.
# Refresh each account at most once per REFRESH_INTERVAL_S (default 30 min = 1800).
REFRESH_INTERVAL_S=1800
# Max accounts fetched concurrently (bounds threads + load on Flipkart). Raise for a tighter
# cadence at large account counts; lower if Flipkart rate-limits.
FETCH_CONCURRENCY=16
#ROSTER_REFRESH_S=300     # safety-net re-read of the cookie roster (mutations wake the poller anyway)
#POLLER_ENABLED=1         # set 0 to disable background fetching (debugging)

# ── Advanced (rarely changed) ────────────────────────────────────────────────
# Flipkart's custom x-user-agent (FKUA) header + a matching browser User-Agent.
#FLIPKART_FKUA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36 FKUA/website/42/website/Desktop
#FLIPKART_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36
# Internal API endpoints + the list filter (change only if Flipkart moves them).
#FLIPKART_ORDERS_BASE=https://www.flipkart.com/api/5/self-serve/orders/
#FLIPKART_DETAIL_URL=https://www.flipkart.com/api/4/page/fetch?
#FLIPKART_FILTER_TYPE=PREORDER_UNITS
